<Project>
  <PropertyGroup>
    <!-- Disable SDK auto-generated assembly attributes globally to avoid duplicate TargetFrameworkAttribute -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Also avoid SDK generating TargetFrameworkAttribute which can duplicate in multi-project builds -->
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
  <!-- Disable implicit compile items only for Core project so it can explicitly include sources -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TeaRecallManager.Core'">
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
</Project>
