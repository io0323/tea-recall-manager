<Project>
  <PropertyGroup>
    <!-- Disable SDK auto-generated assembly attributes globally to avoid duplicate TargetFrameworkAttribute -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Also avoid SDK generating TargetFrameworkAttribute which can duplicate in multi-project builds -->
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
  <!-- Disable SDK implicit compile items for Core project so it can include sources explicitly -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TeaRecallManager.Core' Or '$(MSBuildProjectFile)' == 'TeaRecallManager.Core.csproj'">
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
</Project>
