<Window x:Class="TeaRecallManager.Views.AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="回収影響分析" Width="800" Height="600"
        Background="#2b2b2b" Foreground="#e6e6e6">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0 0 0 8">
      <TextBlock Text="起点 Lot ID:" VerticalAlignment="Center" Margin="0 0 8 0"/>
      <TextBox x:Name="SeedBox" Width="120" Height="28" VerticalContentAlignment="Center"/>
      <Button x:Name="AnalyzeBtn" Content="分析実行" Width="100" Height="28" Margin="8 0 0 0"/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="3*" />
      </Grid.ColumnDefinitions>

      <DataGrid x:Name="RelatedGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                RowBackground="#333" AlternatingRowBackground="#2f2f2f">
        <DataGrid.Columns>
          <DataGridTextColumn Header="LotCode" Binding="{Binding LotCode}" Width="200"/>
          <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="200"/>
          <DataGridTextColumn Header="Shipped" Binding="{Binding IsShipped}" Width="100"/>
          <DataGridTextColumn Header="Shipments" Binding="{Binding ShipmentsCount}" Width="100"/>
        </DataGrid.Columns>
      </DataGrid>

      <lvc:CartesianChart Grid.Column="1" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" />
    </Grid>
  </Grid>
</Window>
</Window>

