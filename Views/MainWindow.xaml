<Window x:Class="TeaRecallManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TeaRecall Manager - ロット一覧"
        Width="1000" Height="700"
        Background="#2b2b2b"
        Foreground="#e6e6e6">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0 0 0 8">
      <TextBox x:Name="SearchBox" Width="300" Height="28" Margin="0 0 8 0"
               VerticalContentAlignment="Center" />
      <Button x:Name="SearchBtn" Content="検索" Width="80" Height="28" />
    </StackPanel>

    <DataGrid x:Name="LotGrid" Grid.Row="1" AutoGenerateColumns="False"
              HeadersVisibility="Column" CanUserAddRows="False"
              RowBackground="#333" AlternatingRowBackground="#2f2f2f"
              GridLinesVisibility="None" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="LotCode" Binding="{Binding LotCode}" Width="140"/>
        <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="200"/>
        <DataGridTextColumn Header="Variety" Binding="{Binding Variety}" Width="120"/>
        <DataGridTextColumn Header="HarvestDate" Binding="{Binding HarvestDate}" Width="160"
                            Binding.StringFormat="{}{0:yyyy-MM-dd}" />
        <DataGridTemplateColumn Header="Status" Width="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border x:Name="StatusBorder" Padding="6" CornerRadius="4" Background="#4caf50">
                <TextBlock x:Name="StatusText" Text="{Binding Status}" HorizontalAlignment="Center" Foreground="#ffffff"/>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Recalled">
                  <Setter TargetName="StatusBorder" Property="Background" Value="#d32f2f" />
                  <Setter TargetName="StatusText" Property="Foreground" Value="#ffffff" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Normal">
                  <Setter TargetName="StatusBorder" Property="Background" Value="#4caf50" />
                  <Setter TargetName="StatusText" Property="Foreground" Value="#ffffff" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="出荷件数" Width="100" Binding="{Binding Shipments.Count}" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
