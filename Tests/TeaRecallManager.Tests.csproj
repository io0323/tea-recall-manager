<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- テストは UI プロジェクトを参照するため Windows ターゲットに合わせる -->
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!-- Prevent duplicate assembly attributes when SDK auto-generates them -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\/TeaRecallManager.Core\/TeaRecallManager.Core.csproj" />
    <ProjectReference Include="..\/TeaRecallManager.csproj" />
  </ItemGroup>
</Project>

