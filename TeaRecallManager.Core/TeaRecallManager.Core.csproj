<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Prevent SDK auto-generated assembly attributes which may duplicate -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Opt out of SDK implicit compile items and include sources explicitly -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ensure any implicit Service files are removed to avoid duplicates -->
    <Compile Remove="Services\**\*.cs" />
    <Compile Remove="**\IRecallAnalysisService.cs" />
    <Compile Remove="**\RecallAnalysisService.cs" />
    <Compile Include="Models\**\*.cs" />
    <Compile Include="Data\**\*.cs" />
    <Compile Include="Repositories\**\*.cs" />
    <Compile Include="Services\Impl\**\*.cs" />
  </ItemGroup>

</Project>

